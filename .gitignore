# ==============================================================
# .gitignore — neyssan project
# Règle : ne commiter que le code source. Jamais de binaires,
#          dépendances, secrets, ou données de test.
# ==============================================================

# --- OS ----------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

# --- Éditeurs ----------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# --- Node / JS ---------------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/

# --- Build outputs -----------------------------------------------
dist/
build/
.cache/
coverage/
*.tsbuildinfo
.next/
out/

# --- Python venvs (JAMAIS dans git) ------------------------------
.venv/
venv/
ENV/
env/
**/.venv/
**/venv/
lib/python*/
.python-version

# --- Python compiled ---------------------------------------------
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
.eggs/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Secrets / Env (garder .env.example) -------------------------
.env
.env.*
!.env.example
!.env.local.example
!**/.env.example
*.bk
*.envlocal*
*.envlocalDEV*
*.envproduction*

# --- Données de test et fixtures ---------------------------------
/fixtures/
my-app/testdata/
my-app/spacy_training/
my-app/scraping-server/

# --- Artifacts runtime -------------------------------------------
artifacts/
diagnostics/
tmp/
*.log
logs/
.verify-venv/
my-app/.parser-tunnel-url
pdf-ingest/.env
pdf-ingest/.env.alembic

# --- Docs / notes internes (pas du code) -------------------------
/docs/
!/docs/
/docs/*
!/docs/plans/
/docs/plans/*
!/docs/plans/export-layout-fidelity-brief.md
!/docs/plans/export-layout-fidelity-audit.md
roocode_doc/
alembic_backups/
pdf-ingest.disabled/

# --- Claude Code (sessions locales) ------------------------------
.claude/
.kilo/
.kilocode/

# --- Backups et données sensibles --------------------------------
*.sql
*.db
*.sqlite
*.sqlite3
backup_*.sql
.gitsshkey.md
audit_report.json

# --- Docker cache ------------------------------------------------
.buildx-cache
.docker/last-runtime-hash

# --- Fichiers lourds / binaires ----------------------------------
*.pdf
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.mp4
*.zip
*.tar.gz
*.gz
*.whl
*.model
*.bin
*.pt
*.pth
*.onnx
*.h5

# --- Convex generated (regénéré automatiquement) -----------------
my-app/convex/_generated/

# --- Vite / vitest -----------------------------------------------
my-app/src/__tests__/**/__snapshots__/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
.tmp-vitest/
.tmp-playwright/
.playwright-browsers/
my-app/Docs
!my-app/docs/
my-app/docs/*
!my-app/docs/audits/
my-app/docs/audits/*
!my-app/docs/audits/2026-03-31-proposal-reopen-lag-audit.md
!my-app/docs/plans/
my-app/docs/plans/*
!my-app/docs/plans/2026-03-31-proposal-reopen-lag-recovery-plan.md
!my-app/docs/plans/2026-04-01-proposal-storage-and-lag-plan.md
everything-claude-code/
/twoweeks/
