{
  "name": "clerk-chrome-extension-final",
  "displayName": "Clerk chrome extension final",
  "version": "0.0.1",
  "description": "A basic Plasmo extension.",
  "author": "Plasmo Corp. <foss@plasmo.com>",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@clerk/chrome-extension": "^2.2.10",
    "axios": "^1.7.9",
    "convex": "^1.19.2",
    "plasmo": "0.90.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "^6.29.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "10.4.0",
    "postcss": "8.4.0",
    "postcss-cli": "^11.0.0",
    "prettier": "3.2.4",
    "tailwindcss": "3.4.0",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": ["activeTab", "cookies", "storage"],
    "host_permissions": ["$PLASMO_PUBLIC_CLERK_SYNC_HOST/*", "https://prepared-grubworm-57.clerk.accounts.dev/*"],
    "action": {
      "default_popup": "popup.html"
      
      
    },
    "key": "$CRX_PUBLIC_KEY"
  },
  "externals": ["react", "react-dom"]
}
