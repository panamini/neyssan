From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Roo <roo@example.com>
Date: Sun, 31 Aug 2025 23:12:00 +0200
Subject: [PATCH] convex: add languages and contact fields to userProfiles schema

Add optional top-level profile fields `languages` and `contact` to the
userProfiles table schema so parsers and UI can store canonical language
and contact information.

---
 my-app/convex/schema.ts | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/my-app/convex/schema.ts b/my-app/convex/schema.ts
index 0000000..0000000 100644
--- a/my-app/convex/schema.ts
+++ b/my-app/convex/schema.ts
@@ -52,6 +52,16 @@ export default defineSchema({
         linkedIn: v.optional(v.string()),
         raw_text: v.optional(v.string()),
+        // New dedicated fields for languages and contact
+        languages: v.optional(v.array(v.string())),
+        contact: v.optional(v.object({
+          // Contact stored as optional phone/address fields (freeform strings)
+          phone: v.optional(v.string()),
+          address: v.optional(v.string()),
+        })),
         metadata: v.optional(
             v.object({
                 source: v.optional(v.string()),
*** End Patch