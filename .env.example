CONVEX_PARSER_URL=https://parser.dasti.ai

# Required for ./run.sh local-fast on a fresh machine.
# These are Convex slugs, not secrets. Ask a project owner for the shared
# team/project values, then copy this file to .env.local and fill them in.
CONVEX_TEAM=
CONVEX_PROJECT=

# Optional. Keep unset for first-time setup; Convex will create/discover a
# local deployment. Set only when reusing an existing local deployment.
# CONVEX_DEPLOYMENT=local:<deployment_name>
