CONVEX_PARSER_URL=https://parser.dasti.ai

# Required for ./run.sh local-fast on a fresh machine.
# These are Convex slugs, not secrets. Ask a project owner for the shared
# team/project values, then copy this file to .env.local and fill them in.
CONVEX_TEAM=
CONVEX_PROJECT=

# Optional. Keep unset for first-time setup; Convex will create/discover a
# local deployment. Set only when reusing an existing local deployment.
# CONVEX_DEPLOYMENT=local:<deployment_name>

# PR305 private-beta MCP server runtime.
# Copy these entries to the root .env.local (never my-app/.env.local), keep
# that file at mode 600, and run ./run.sh mcp-check before starting the stack.
VITE_PORT=5196
OPEN_BROWSER=0
MCP_OAUTH_PRODUCTION_RUNTIME=1
MCP_OAUTH_PRODUCTION_APPROVED=1
MCP_OAUTH_PRODUCTION_ROUTE_WIRING=1
MCP_OAUTH_PRODUCTION_AUTHORIZATION_ORIGIN=https://mcp.twoweeks.ai
MCP_OAUTH_PRODUCTION_RESOURCE=https://mcp.twoweeks.ai/mcp
MCP_OAUTH_PRODUCTION_CLIENT_IDS=local-chatgpt-client
MCP_OAUTH_PRODUCTION_REDIRECT_URIS=https://chatgpt.com/connector/oauth/b7v_6OncLEsg
MCP_OAUTH_PRODUCTION_PRIVATE_BETA_ENABLED=1
MCP_OAUTH_PRODUCTION_PRIVATE_BETA_CLIENT_IDS=local-chatgpt-client
MCP_OAUTH_PRODUCTION_PRIVATE_BETA_RESOURCES=https://mcp.twoweeks.ai/mcp

# Server-only values. Never prefix these with VITE_.
MCP_OAUTH_PRODUCTION_ISSUER=
MCP_OAUTH_PRODUCTION_PROVIDER_ENVIRONMENT=
CLERK_JWT_ISSUER_DOMAIN=
# `./run.sh mcp-private-beta` derives the matching public Clerk browser key in
# memory from this issuer. It does not print or persist the derived value.
CONVEX_URL=http://127.0.0.1:3210
CONVEX_AUTH_TOKEN=

# Secret material. Store only the OAuth digest here; the raw OAuth secret
# belongs in the macOS Keychain entry twoweeks-mcp-chatgpt-private-beta.
MCP_OAUTH_PRODUCTION_CLIENT_SECRET_SHA256=
# Generic ./run.sh tunnel only. The MCP mode uses the existing mode-400 named
# tunnel credentials file under ~/.cloudflared instead of this token.
TUNNEL_TOKEN=
