# Local-only Vite/Convex settings.
#
# Do not commit your real my-app/.env.local. For ./run.sh local-fast, prefer
# putting CONVEX_TEAM and CONVEX_PROJECT in the root .env.local copied from
# ../.env.example.
#
# Keep server-only MCP_OAUTH_PRODUCTION_*, CONVEX_AUTH_TOKEN, and tunnel
# credentials in the root .env.local. Vite loads this file for client-facing
# VITE_* values only; ./run.sh mcp-check rejects misplaced MCP server keys.

# run.sh local-fast starts local Convex on this URL by default.
VITE_CONVEX_URL=http://127.0.0.1:3210

# Clerk is required for signed-in app flows.
VITE_CLERK_PUBLISHABLE_KEY=
