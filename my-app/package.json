{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "node ./scripts/ensure-parser-and-run-frontend.mjs",
    "dev:frontend:raw": "vite --open",
    "dev:backend": "convex dev --local",
    "predev": "convex dev --until-success && convex dashboard",
    "build": "tsc -b && vite build",
    "lint": "tsc && eslint .  --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest --run --exclude pdf-ingest/*",
    "test:watch": "vitest",
    "test:golden": "vitest --run -t \"Golden set NER fusion\"",
    "extract:strict": "tsx scripts/run-extract-profile-strict.ts",
    "frontend": "node ./scripts/ensure-parser-and-run-frontend.mjs"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.22.13",
    "@convex-dev/migrations": "^0.2.5",
    "@convex-dev/rate-limiter": "^0.2.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@hookform/resolvers": "^4.1.0",
    "@langchain/mistralai": "^0.2.0",
    "@langchain/openai": "^0.4.4",
    "@mistralai/mistralai": "^1.9.18",
    "@radix-ui/react-form": "^0.1.2",
    "@radix-ui/themes": "^3.2.0",
    "@remirror/core": "^3.0.2",
    "@remirror/extension-bold": "^3.0.2",
    "@remirror/extension-heading": "^3.0.2",
    "@remirror/extension-history": "^3.0.2",
    "@remirror/extension-italic": "^3.0.2",
    "@remirror/extension-link": "^3.0.2",
    "@remirror/extension-list": "^3.0.2",
    "@remirror/extension-underline": "^3.0.2",
    "@remirror/pm": "^3.0.1",
    "@remirror/react": "^3.0.3",
    "@sentry/react": "^9.1.0",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "convex": "^1.27.3",
    "dompurify": "^3.2.6",
    "jose": "^6.0.6",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.10.26",
    "lodash": "^4.17.21",
    "lru-cache": "^11.0.2",
    "lucide-react": "^0.475.0",
    "node-fetch": "^3.3.2",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^3.8.162",
    "pino": "^9.9.0",
    "radix-ui": "^1.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-quill": "^2.0.0",
    "react-router-dom": "^7.9.4",
    "remirror": "^3.0.3",
    "svix": "^1.57.0",
    "tailwind-merge": "^3.0.1",
    "tesseract.js": "^6.0.1",
    "undici": "^6.21.3",
    "use-debounce": "^10.0.6",
    "uuid": "^13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^21.1.7",
