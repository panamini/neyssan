{
  "compilerOptions": {
      "target": "es2020",
    "lib": ["es2020", "dom", "dom.iterable"],
    "jsx": "react-jsx", 
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    
    "strict": true,
    "noEmit": true,
        "forceConsistentCasingInFileNames": true,

    "esModuleInterop": true
  },
  "include": [
    "vite.config.ts",
    "src/modules/application-harness/fingerprints.ts",
    "src/modules/application-harness/schema.ts",
    "src/modules/internal-tool-contracts/contractRules.ts",
    "src/modules/internal-tool-contracts/contracts.ts",
    "src/modules/internal-tool-contracts/schema.ts",
    "src/modules/local-mcp/localMcpDevAuthConfig.ts",
    "src/modules/local-mcp/localMcpDevEndpoint.ts",
    "src/modules/local-mcp/localMcpToolsListFixture.ts",
    "src/modules/local-mcp/mcpAccountLinkingStorageBoundary.ts",
    "src/modules/local-mcp/mcpAuthPolicyBoundary.ts",
    "src/modules/local-mcp/mcpAuthRequestOrchestrator.ts",
    "src/modules/local-mcp/mcpDescriptorRegistry.ts",
    "src/modules/local-mcp/mcpSchemaProjection.ts",
    "src/modules/local-mcp/schema.ts",
    "src/modules/local-mcp/toolRegistry.ts"
  ]
  
}
