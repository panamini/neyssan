"""
Helper for calling Convex HTTP Actions from pdf-ingest.

Provides:
- call_convex_action(action_path, payload): posts JSON to Convex action endpoint
  with optional Authorization Bearer token (read from CONVEX_SERVICE_TOKEN env var).
- Exponential backoff retry logic configurable via CONVEX_RETRY_ATTEMPTS and CONVEX_TIMEOUT_MS.

Behavior:
- If CONVEX_URL is set it'll be used as the base. If action_path looks like a full URL it will be used as-is.
- If CONVEX_SERVICE_TOKEN is present in env, Authorization: Bearer <token> is added.
- Retries on 5xx and 429. Does NOT retry on other 4xx (treat as client error).
- Returns parsed JSON on success (HTTP 2xx). Raises ConvexPersistError with details on failure.
"""
from __future__ import annotations

import os
import time
import logging
from typing import Any, Dict, Optional
from urllib.parse import urljoin

import requests
import random

logger = logging.getLogger("pdf-ingest.convex_persist")
logger.setLevel(logging.INFO)


class ConvexPersistError(Exception):
    """Raised when the Convex action call fails after retries."""


def _is_full_url(path: str) -> bool:
    return path.startswith("http://") or path.startswith("https://")


def call_convex_action(action_path: str, payload: Dict[str, Any]) -> Dict[str, Any]:
    """
    Call a Convex HTTP action.

    Parameters:
    - action_path: either a full URL (https://...) or a path like /api/actions/persistProfile
    - payload: JSON-serializable dict to POST

    Returns:
    - response JSON as dict on success

    Raises:
    - ConvexPersistError on permanent failure, with message containing status and body if available.
    """
    # Configuration from env
    convex_url = os.getenv("CONVEX_URL") or os.getenv("VITE_CONVEX_URL") or os.getenv("NEXT_PUBLIC_CONVEX_URL")
    service_token = os.getenv("CONVEX_SERVICE_TOKEN")
    try:
        timeout_ms = int(os.getenv("CONVEX_TIMEOUT_MS", "10000"))
    except Exception:
        timeout_ms = 10000
    try:
        attempts = int(os.getenv("CONVEX_RETRY_ATTEMPTS", "4"))
    except Exception:
        attempts = 4

    timeout = max(1.0, timeout_ms / 1000.0)

    # Resolve URL
    if _is_full_url(action_path):
        url = action_path
    else:
        if not convex_url:
            raise ConvexPersistError("Convex base URL not configured (CONVEX_URL or VITE_CONVEX_URL required)")
        url = urljoin(convex_url.rstrip("/") + "/", action_path.lstrip("/"))

    headers = {
        "Content-Type": "application/json",
    }
    if service_token:
        headers["Authorization"] = f"Bearer {service_token}"

    # Exponential backoff parameters: base_delay seconds (configurable), doubled each retry
    try:
        base_delay = float(os.getenv("CONVEX_BACKOFF_BASE", "0.5"))
    except Exception:
        base_delay = 0.5

    last_exc: Optional[Exception] = None
    for attempt in range(1, attempts + 1):
        try:
            logger.info("Calling Convex action %s (attempt %d/%d)", url, attempt, attempts)
            resp = requests.post(url, json=payload, headers=headers, timeout=timeout)
            status = resp.status_code
            text = None
            try:
                text = resp.text
            except Exception:
                text = "<unreadable response body>"

            # Successful responses (2xx)
            if 200 <= status < 300:
                try:
                    return resp.json()
                except Exception:
                    # If not JSON, return text wrapped in dict for downstream callers
                    return {"raw_text": resp.text}

            # Client errors: do not retry except 429 (rate limit)
            if 400 <= status < 500 and status != 429:
                msg = f"Convex action returned client error {status}: {text}"
                logger.error(msg)
                raise ConvexPersistError(msg)

            # For 429 and 5xx: retryable
            if status == 429 or status >= 500:
                msg = f"Convex action returned retryable status {status}: {text}"
                logger.warning(msg)
                last_exc = ConvexPersistError(msg)
                # fall through to retry/backoff

            else:
                # Unexpected non-success status — treat as permanent error
                msg = f"Convex action returned unexpected status {status}: {text}"
                logger.error(msg)
                raise ConvexPersistError(msg)

        except requests.RequestException as re:
            # Network / timeout errors -> retry
            logger.warning("Request to Convex action failed (attempt %d/%d): %s", attempt, attempts, re)
            last_exc = re

        # Backoff before next attempt if any remaining
        if attempt < attempts:
            sleep_for = base_delay * (2 ** (attempt - 1))
            logger.info("Retrying after %.2fs...", sleep_for)
            time.sleep(sleep_for)

    # All attempts exhausted
    if last_exc:
        raise ConvexPersistError(f"Failed to call Convex action after {attempts} attempts: {last_exc}")
    else:
        raise ConvexPersistError(f"Failed to call Convex action after {attempts} attempts (unknown reason)")
